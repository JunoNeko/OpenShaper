# This deployment's build settings (Vite reads this file for production builds).
#
# The fin designer is served to testers from this fork. Analytics are on, with this
# fork's own PostHog project: VITE_POSTHOG_KEY and VITE_POSTHOG_HOST (=/edge) are
# Cloudflare *build* variables, as in docs/design/analytics.md ("Env vars"). Without
# a key nothing is sent, but the consent banner still shows. To switch analytics off
# again (no banner, nothing sent), add back:
#   VITE_DISABLE_ANALYTICS=true

# Where testers email feedback: shown in a callout at the top of the fin designer's
# help page (/docs/fin-designer). Remove to hide it.
VITE_FEEDBACK_EMAIL=stephen.franklin@outlook.com
