# This deployment's build settings (Vite reads this file for production builds).
#
# The fin designer is served to testers from this fork. Analytics are off: nothing is
# sent and no consent banner is shown (see analyticsDisabled in src/analytics.ts).
# Remove this line, and set VITE_POSTHOG_KEY / VITE_POSTHOG_HOST as in .env.example,
# to turn them back on with a PostHog project of your own.
VITE_DISABLE_ANALYTICS=true
